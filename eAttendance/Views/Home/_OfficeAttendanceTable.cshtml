@model IEnumerable<eAttendance.ViewModel.EmployeeCountDashBoardModl>
@{
    int sno = 1;
}





<style>
    .tbl-dashboard thead th {
        color: #fff;
        text-align: center;
        vertical-align: middle;
        font-weight: 600;
    }

    .th-sn {
        background: #455A64;
    }
    /* Serial No */
    .th-office {
        background: #3F51B5;
    }
    /* Office */
    .th-total {
        background: #2196F3;
    }
    /* Total Employee */
    .th-present {
        background: #4CAF50;
    }
    /* Present */
    .th-absent {
        background: #F44336;
    }
    /* Absent */
    .th-leave {
        background: #FF9800;
    }
    /* Leave */
    .th-visit {
        background: #9C27B0;
    }
    /* Official Visit */
    .th-active {
        background: #009688;
    }
    /* Active */
    .th-inactive {
        background: #607D8B;
    }
    /* Inactive */

    .tbl-dashboard tbody td {
        vertical-align: middle;
    }

    .tbl-dashboard tbody tr:hover {
        background: #f5f5f5;
    }
</style>

<div class="table-responsive">
    <table class="table table-bordered table-hover tbl-dashboard">
        <thead>
            <tr>
                <th class="th-sn">क्र.सं.</th>
                <th class="th-office">कार्यालयको नाम</th>
                <th class="th-total">जम्मा कर्मचारी</th>
                <th class="th-present">उपस्थिती</th>
                <th class="th-absent">अनुपस्थित</th>
                <th class="th-leave">बिदा</th>
                <th class="th-visit">काज</th>
                <th class="th-active">सक्रिय कर्मचारी</th>
                <th class="th-inactive">निष्क्रिय कर्मचारी</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Where(x=>x.OfficeName!= "सुदूरपश्चिम विश्वविद्यालय"))
            {
                <tr>
                    <td class="text-center">@Html.Raw(EnglishToNepaliNumber.ConvertToNepaliNumber(sno++))</td>

                    <td>
                        <a href="@Url.Action("Index","Home",new { nlogDate=ViewBag.LogDate, officeId=m.OfficeId })">
                            @m.OfficeName
                        </a>
                    </td>

                    <td class="text-center">@EnglishToNepaliNumber.ConvertToNepaliNumber(m.TotalEmployee)</td>
                    <td class="text-center text-success"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.Present)</strong></td>
                    <td class="text-center text-danger"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.ActiveEmployee - (m.Present + m.OnLeave + m.OnVisit))</strong></td>
                    <td class="text-center text-warning"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.OnLeave)</strong></td>
                    <td class="text-center" style="color:#9C27B0;"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.OnVisit)</strong></td>
                    <td class="text-center text-info"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.ActiveEmployee)</strong></td>
                    <td class="text-center text-muted"><strong>@EnglishToNepaliNumber.ConvertToNepaliNumber(m.InactiveEmployee)</strong></td>
                </tr>
            }
            @{
                var totalEmployee = Model.Sum(x => x.TotalEmployee);
                var present = Model.Sum(x => x.Present);
                var leave = Model.Sum(x => x.OnLeave);
                var visit = Model.Sum(x => x.OnVisit);
                var active = Model.Sum(x => x.ActiveEmployee);
                var inactive = Model.Sum(x => x.InactiveEmployee);
                var absent = Math.Max(0, active - (present + leave + visit));
            }

            <tr style="background:#ECEFF1;font-weight:bold;">
                <td colspan="2" class="text-center">जम्मा</td>
                <td class="text-center">@EnglishToNepaliNumber.ConvertToNepaliNumber(totalEmployee)</td>
                <td class="text-center text-success">@EnglishToNepaliNumber.ConvertToNepaliNumber(present)</td>
                <td class="text-center text-danger">@EnglishToNepaliNumber.ConvertToNepaliNumber(absent)</td>
                <td class="text-center text-warning">@EnglishToNepaliNumber.ConvertToNepaliNumber(leave)</td>
                <td class="text-center" style="color:#9C27B0">@EnglishToNepaliNumber.ConvertToNepaliNumber(visit)</td>
                <td class="text-center text-info">@EnglishToNepaliNumber.ConvertToNepaliNumber(active)</td>
                <td class="text-center text-muted">@EnglishToNepaliNumber.ConvertToNepaliNumber(inactive)</td>
            </tr>
        </tbody>
    </table>
</div>